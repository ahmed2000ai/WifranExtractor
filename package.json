{
  "name": "wifran-offers-extractor",
  "version": "1.0.0",
  "description": "Wifran Offers Extractor - Internal desktop tool for extracting supermarket offers from PDF leaflets",
  "main": "./out/main/index.js",
  "author": "Wifran",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "validate:fixtures": "tsx scripts/validateFixtures.ts",
    "test:ocr:minimal": "tsx scripts/testMinimalMistralOcr.ts",
    "test:smoke": "tsx scripts/runLocalSmokeTests.ts",
    "test:accuracy": "vitest run src/main/reporting src/main/db src/main/prepublish src/shared/__tests__",
    "test": "npm run typecheck && npm run validate:fixtures && npm run test:smoke",
    "harness:accuracy": "tsx scripts/runAccuracyHarness.ts",
    "test:harness": "vitest run src/shared/accuracy-harness",
    "qa:copy-extraction": "node scripts/qa-copy-extraction.js",
    "ml:doctor": "tsx scripts/mlDoctor.ts",
    "ml:dataset:verify": "tsx scripts/mlDatasetVerify.ts",
    "ml:model:registry:verify": "tsx scripts/mlRegistryVerify.ts",
    "ml:inference:fixture": "tsx scripts/mlInferenceFixture.ts",
    "ml:auto-acceptance:verify": "tsx scripts/mlAutoAcceptanceVerify.ts",
    "test:page-first-ocr": "vitest run src/main/page-first",
    "test:rev1": "vitest run src/main/page-first/__tests__/rev1NormalizersAndMath.test.ts src/shared/utils/__tests__/priceAndUnitNormalizer.test.ts",
    "benchmark:golden": "tsx scripts/verify-golden-benchmark.ts",
    "pilot:page-first-ocr": "tsx scripts/pilotPageFirstOcr.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "pack:win": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@google/genai": "^2.30.0",
    "@mistralai/mistralai": "^2.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.363.0",
    "onnxruntime-node": "^1.27.0",
    "p-limit": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.78",
    "@types/react-dom": "^18.2.25",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^4.1.9"
  }
}
