# ============================================================
# Wifran Offers Extractor - Environment Example
# Copy this file to .env.local and fill in real values locally.
# Never commit .env.local.
# ============================================================

# ============================================================
# Required credentials - operator must fill these
# ============================================================

MISTRAL_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Safe defaults - usually do not change
# ============================================================

SUPABASE_STORAGE_BUCKET=offer-images

MISTRAL_OCR_MODEL=mistral-ocr-2512
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr

OCR_CHUNK_SIZE=1
OCR_MAX_CONCURRENT_REQUESTS=1
OCR_MAX_RETRIES=6
OCR_RETRY_BASE_DELAY_MS=3000
OCR_REQUEST_TIMEOUT_MS=240000

OCR_REQUESTS_PER_SECOND_LIMIT=1
OCR_MIN_REQUEST_INTERVAL_MS=5000
OCR_TOKENS_PER_MINUTE_LIMIT=50000
OCR_TPM_SAFETY_RATIO=0.75
OCR_ESTIMATED_TOKENS_PER_PAGE=3000
OCR_ESTIMATED_TOKENS_PER_DENSE_PAGE=5000
OCR_RATE_LIMIT_MODE=free_tier_safe
OCR_CONFIDENCE_GRANULARITY=page
OCR_TABLE_FORMAT=markdown

# Item-level OCR (used by crop + OCR workflow)
OCR_ITEM_MIN_REQUEST_INTERVAL_MS=1100
OCR_ITEM_MAX_CONCURRENT_REQUESTS=1
OCR_ITEM_MAX_RETRIES=5
OCR_ITEM_REQUEST_TIMEOUT_MS=120000
OCR_ITEM_RATE_LIMIT_MODE=free_tier_safe
ITEM_OCR_OUTPUT_SCHEMA=minimal_item
ITEM_OCR_SAVE_RAW_RESPONSE=false

PDF_RENDER_DPI=250
IMAGE_CROP_PADDING_PERCENT=8
IMAGE_OUTPUT_FORMAT=webp
IMAGE_OUTPUT_QUALITY=85

DEFAULT_OFFER_DURATION_DAYS=7
IMPORT_DEFAULT_STATUS=published
ALLOW_NEEDS_REVIEW_FALLBACK=true
PUBLISH_WARNINGS_ALLOWED=true
LOW_CONFIDENCE_THRESHOLD=0.75
DATA_QUALITY_NEEDS_REVIEW_THRESHOLD=70
SKIP_DUPLICATE_OFFERS=true
AUTO_CREATE_BRANDS=true
AUTO_CREATE_PRODUCTS=true
AUTO_CREATE_CATEGORIES=false
REQUIRE_IMAGE_FOR_DRAFT=false

DEBUG_SAVE_INTERMEDIATE_FILES=false
LOG_LEVEL=info

OCR_CONTINUE_ON_CHUNK_FAILURE=true
OCR_ALLOW_PARTIAL_IMPORT=true
OCR_RESPECT_RETRY_AFTER=true
OCR_MAX_ZERO_ITEM_CHUNKS_WARNING_THRESHOLD=5
